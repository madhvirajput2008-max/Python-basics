import matplotlib.pyplot as plt
from mpl_toolkits.mplot3d import Axes3D

fig = plt.figure()
ax = fig.add_subplot(111, projection='3d')

x = [0,1,1,0,0,1,1,0]
y = [0,0,1,1,0,0,1,1]
z = [0,0,0,0,1,1,1,1]

ax.scatter(x, y, z)

edges = [
    [0,1],[1,2],[2,3],[3,0],
    [4,5],[5,6],[6,7],[7,4],
    [0,4],[1,5],[2,6],[3,7]
]

for e in edges:
    ax.plot(
        [x[e[0]], x[e[1]]],
        [y[e[0]], y[e[1]]],
        [z[e[0]], z[e[1]]]
    )

ax.set_xlabel("X")
ax.set_ylabel("Y")
ax.set_zlabel("Z")

plt.show()
