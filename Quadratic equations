import math

# input
a = float(input("Enter value of a: "))
b = float(input("Enter value of b: "))
c = float(input("Enter value of c: "))

# discriminant
D = b*b - 4*a*c

if D > 0:
    R1 = (-b + math.sqrt(D)) / (2*a)
    R2 = (-b - math.sqrt(D)) / (2*a)
    print("Roots are %.2f and %.2f" % (R1, R2))

elif D == 0:
    R = -b / (2*a)
    print("Both roots are equal:", round(R, 2))

else:
    realpart = -b / (2*a)
    imaginarypart = math.sqrt(-D) / (2*a)
    print("R1 = %.2f + %.2fi" % (realpart, imaginarypart))
    print("R2 = %.2f - %.2fi" % (realpart, imaginarypart))
